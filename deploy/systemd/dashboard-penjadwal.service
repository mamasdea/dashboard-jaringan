# Penjadwal Laravel; dipicu dashboard-penjadwal.timer tiap menit.
# Jadwalnya ada di routes/console.php: tanda hidup, retensi data monitoring,
# dan pembersihan. Tidak ada jadwal yang menghubungi perangkat jaringan.

[Unit]
Description=Penjadwal Dashboard Jaringan (schedule:run)
After=postgresql.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
WorkingDirectory=/srv/dashboard-jaringan
ExecStart=/usr/bin/php artisan schedule:run --no-interaction

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
