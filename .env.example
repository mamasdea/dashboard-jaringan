APP_NAME="Dashboard Jaringan Intra Wonosobo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dashboard_jaringan
DB_USERNAME=dashboard_jaringan
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Peta jaringan. Kosongkan untuk memakai OpenStreetMap; untuk produksi arahkan
# ke penyedia tile berlangganan atau server tile internal, dan sesuaikan atribusinya.
PETA_TILE_URL=
PETA_TILE_ATRIBUSI=
PETA_TILE_SUBDOMAIN=
PETA_TILE_ZOOM_MAKS=
PETA_PUSAT_LINTANG=
PETA_PUSAT_BUJUR=
PETA_ZOOM=

# Monitoring. Adapter "simulasi" tidak mengirim paket apa pun ke jaringan.
MONITORING_ADAPTER=simulasi
MONITORING_INTERVAL_DETIK=60
MONITORING_GAGAL_BERTURUT=3
MONITORING_PULIH_BERTURUT=2
MONITORING_KEDALUWARSA_KALI_INTERVAL=3
MONITORING_AMBANG_LATENCY_MS=100
MONITORING_AMBANG_PACKET_LOSS_PERSEN=5
# Kunci penyegel kredensial SNMP: php artisan monitoring:buat-kunci
# Kunci privat hanya dipasang di host kolektor.
MONITORING_KUNCI_PUBLIK=
MONITORING_KUNCI_PRIVAT=

# Kolektor nyata (MONITORING_ADAPTER=jaringan). Lihat docs/PANDUAN-UJI-SWITCH.md.
# Alamat/CIDR yang boleh dihubungi, dipisah koma. Kosong = tidak ada yang diizinkan.
MONITORING_SASARAN_DIIZINKAN=
MONITORING_ICMP_JUMLAH_PAKET=4
MONITORING_ICMP_BATAS_WAKTU_MS=1000
MONITORING_SNMP_BATAS_WAKTU_MS=1500
MONITORING_SNMP_PERCOBAAN_ULANG=1
# Satu endpoint uji untuk `php artisan monitoring:uji-endpoint`.
MONITORING_UJI_ALAMAT=
MONITORING_UJI_PORT_UPLINK=
# v3 (diutamakan) atau v2c (hanya bila perangkat tidak mendukung v3; community baca-saja).
MONITORING_UJI_SNMP_VERSI=
MONITORING_UJI_SNMP_PENGGUNA=
MONITORING_UJI_SNMP_TINGKAT_KEAMANAN=authPriv
MONITORING_UJI_SNMP_PROTOKOL_AUTH=SHA
MONITORING_UJI_SNMP_SANDI_AUTH=
MONITORING_UJI_SNMP_PROTOKOL_PRIV=AES
MONITORING_UJI_SNMP_SANDI_PRIV=
MONITORING_UJI_SNMP_COMMUNITY=

# Dashboard: selang membaca ulang hasil tersimpan (10-300 detik).
DASHBOARD_SEGARKAN_DETIK=30

# Tiket gangguan. Insiden monitoring membuat tiket otomatis, paling banyak
# satu tiket terbuka per endpoint.
TIKET_OTOMATIS=true
TIKET_PRIORITAS_OTOMATIS=tinggi

# Retensi data monitoring mentah (hari); 0 = tidak pernah dihapus. Riwayat
# status dan insiden tidak dipangkas. Dijalankan penjadwal tiap malam.
MONITORING_RETENSI_HASIL_HARI=90
MONITORING_RETENSI_TRAFIK_HARI=90
MONITORING_RETENSI_DETAK_HARI=30

# Health check. `php artisan kesehatan:periksa` selalu tersedia di server.
# Titik HTTP /kesehatan hanya aktif bila token diisi (Authorization: Bearer).
# Buat dengan: openssl rand -hex 32
KESEHATAN_TOKEN=
KESEHATAN_PENJADWAL_DETIK=180
KESEHATAN_ANTREAN_DETIK=300
KESEHATAN_DISK_MINIMUM_MB=1024

# ---------------------------------------------------------------------------
# Produksi (lihat docs/DEPLOYMENT.md). Nilai di atas adalah bawaan pengembangan;
# di server ubah sekurangnya:
#   APP_ENV=production          APP_DEBUG=false
#   APP_URL=https://<nama host intranet>
#   LOG_STACK=single            LOG_LEVEL=warning       (dirotasi logrotate)
#   SESSION_SECURE_COOKIE=true  SESSION_ENCRYPT=true
#   MONITORING_ADAPTER=jaringan (hanya di host kolektor, bersama
#   MONITORING_KUNCI_PRIVAT dan MONITORING_SASARAN_DIIZINKAN)
# Berkas .env berisi rahasia: milik root, hanya terbaca grup layanan (0640),
# tidak masuk repositori dan dicadangkan terpisah.
# ---------------------------------------------------------------------------
